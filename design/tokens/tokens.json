{
  "$description": "Lifa design tokens, single source of truth (step 2). W3C Design Tokens (DTCG) format, built by design/generators/build.mjs into SwiftUI, Compose, ArkUI and CSS. Brand palette from the engineering brief; *-text, line-strong and every dark value are derived for WCAG 2.2 AA (see design/tokens/contrast-pairs.json and design/README.md).",
  "palette": {
    "$type": "color",
    "forest": { "$value": "#0B2E21", "$description": "Brand. Hero cards, logo tile" },
    "primary": { "$value": "#11402F", "$description": "Brand. Primary buttons, selected states" },
    "gold": { "$value": "#D9B373", "$description": "Brand. Decorative only (fails as text on light surfaces)" },
    "gold-text": { "$value": "#7A5A1E", "$description": "Brand. Gold text on light surfaces" },
    "leaf": { "$value": "#3E8A5A", "$description": "Brand. Progress, success icons, focus ring. Non-text only on light surfaces (3.8:1)" },
    "cream": { "$value": "#F6F3EC", "$description": "Brand. App background" },
    "card": { "$value": "#FFFFFF", "$description": "Brand. Cards" },
    "line": { "$value": "#E4DED1", "$description": "Brand. Dividers and card borders (decorative)" },
    "ink": { "$value": "#17231D", "$description": "Brand. Primary text" },
    "muted": { "$value": "#56625B", "$description": "Brand. Secondary text" },
    "warning": { "$value": "#A3620E", "$description": "Brand. Warning icons and borders (4.4:1 on cream, so not for body text)" },
    "critical": { "$value": "#A23B2A", "$description": "Brand. Errors and destructive actions" }
  },
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "{palette.cream}" },
      "surface": { "$value": "{palette.card}" },
      "line": { "$value": "{palette.line}" },
      "line-strong": { "$value": "#7E8781", "$description": "Input and control borders, 3:1 (WCAG 1.4.11)" },
      "text": { "$value": "{palette.ink}" },
      "text-muted": { "$value": "{palette.muted}" },
      "primary": { "$value": "{palette.primary}" },
      "primary-pressed": { "$value": "{palette.forest}" },
      "on-primary": { "$value": "#FFFFFF" },
      "hero": { "$value": "{palette.forest}" },
      "hero-inset": { "$value": "#164634" },
      "on-hero": { "$value": "#FFFFFF" },
      "on-hero-muted": { "$value": "#B7C9BE" },
      "hero-accent": { "$value": "{palette.gold}" },
      "hero-positive": { "$value": "#8FD0A3" },
      "gold": { "$value": "{palette.gold}" },
      "gold-text": { "$value": "{palette.gold-text}" },
      "gold-soft": { "$value": "#F7EAD0" },
      "leaf": { "$value": "{palette.leaf}" },
      "leaf-text": { "$value": "#2F6E47", "$description": "Accessible green text (5.5:1 on cream)" },
      "leaf-soft": { "$value": "#E3F0E6" },
      "warning": { "$value": "{palette.warning}" },
      "warning-text": { "$value": "#8A520B", "$description": "Accessible warning text (5.8:1 on cream)" },
      "warning-soft": { "$value": "#FBF1DF" },
      "critical": { "$value": "{palette.critical}" },
      "critical-soft": { "$value": "#F8E5E1" },
      "focus": { "$value": "{palette.leaf}" },
      "scrim": { "$value": "#0B2E2199" },
      "avatar-green-bg": { "$value": "#E3F0E6" },
      "avatar-green-fg": { "$value": "{palette.primary}" },
      "avatar-gold-bg": { "$value": "#F7EAD0" },
      "avatar-gold-fg": { "$value": "{palette.gold-text}" },
      "avatar-lavender-bg": { "$value": "#E9E6F5" },
      "avatar-lavender-fg": { "$value": "#4B3F8C" }
    },
    "dark": {
      "background": { "$value": "#0F1A15" },
      "surface": { "$value": "#17251E" },
      "line": { "$value": "#2C3B33" },
      "line-strong": { "$value": "#6E7E74" },
      "text": { "$value": "#EDF1EC" },
      "text-muted": { "$value": "#A8B3AC" },
      "primary": { "$value": "#8FCBA2" },
      "primary-pressed": { "$value": "#A7D8B6" },
      "on-primary": { "$value": "{palette.forest}" },
      "hero": { "$value": "#133A2B" },
      "hero-inset": { "$value": "#1B4836" },
      "on-hero": { "$value": "#FFFFFF" },
      "on-hero-muted": { "$value": "#B7C9BE" },
      "hero-accent": { "$value": "{palette.gold}" },
      "hero-positive": { "$value": "#8FD0A3" },
      "gold": { "$value": "{palette.gold}" },
      "gold-text": { "$value": "#E3C38A" },
      "gold-soft": { "$value": "#3A2E17" },
      "leaf": { "$value": "#6DBB86" },
      "leaf-text": { "$value": "#6DBB86" },
      "leaf-soft": { "$value": "#1D3326" },
      "warning": { "$value": "#E8A951" },
      "warning-text": { "$value": "#E8A951" },
      "warning-soft": { "$value": "#3A2A12" },
      "critical": { "$value": "#F0907E" },
      "critical-soft": { "$value": "#3D1D18" },
      "focus": { "$value": "#8FCBA2" },
      "scrim": { "$value": "#000000B3" },
      "avatar-green-bg": { "$value": "#1D3326" },
      "avatar-green-fg": { "$value": "#8FCBA2" },
      "avatar-gold-bg": { "$value": "#3A2E17" },
      "avatar-gold-fg": { "$value": "#E3C38A" },
      "avatar-lavender-bg": { "$value": "#2B2645" },
      "avatar-lavender-fg": { "$value": "#C9C1F2" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Sora", "Noto Sans", "system-ui", "sans-serif"], "$description": "Sora lacks Tshivenda ḓ ḽ ṅ ṋ ṱ; platforms fall back per glyph (D-039)" },
      "body": { "$value": ["DM Sans", "Noto Sans", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "file": {
      "$description": "Bundled font files (design/fonts/ttf), keyed by family and weight",
      "sora-600": { "$value": "Sora-SemiBold" },
      "sora-700": { "$value": "Sora-Bold" },
      "dmsans-400": { "$value": "DMSans-Regular" },
      "dmsans-500": { "$value": "DMSans-Medium" },
      "dmsans-700": { "$value": "DMSans-Bold" }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Sizes in points (iOS pt, Android sp, HarmonyOS fp, web px→rem). All scale with the user's text size.",
    "display": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "56", "lineHeight": "60", "letterSpacing": "-1" } },
    "title-1": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "26", "lineHeight": "32", "letterSpacing": "-0.3" } },
    "title-2": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.semibold}", "fontSize": "20", "lineHeight": "26", "letterSpacing": "-0.2" } },
    "title-3": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.semibold}", "fontSize": "17", "lineHeight": "22", "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "16", "lineHeight": "24", "letterSpacing": "0" } },
    "body-strong": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.bold}", "fontSize": "16", "lineHeight": "24", "letterSpacing": "0" } },
    "label": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "15", "lineHeight": "20", "letterSpacing": "0" } },
    "button": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.bold}", "fontSize": "17", "lineHeight": "22", "letterSpacing": "0" } },
    "caption": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "13", "lineHeight": "18", "letterSpacing": "0" } },
    "overline": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.bold}", "fontSize": "12", "lineHeight": "16", "letterSpacing": "1" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 10, "unit": "px" }, "$description": "Inputs, chips, small tiles" },
    "md": { "$value": { "value": 14, "unit": "px" }, "$description": "Buttons, list rows, option cards" },
    "lg": { "$value": { "value": 18, "unit": "px" }, "$description": "Cards" },
    "xl": { "$value": { "value": 24, "unit": "px" }, "$description": "Hero cards, sheets" },
    "pill": { "$value": { "value": 999, "unit": "px" }, "$description": "Badges, avatars" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4-point scale",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": { "value": 44, "unit": "px" }, "$description": "Minimum touch target (brief). Android raises it to 48 dp per platform guidance." },
    "touch-min-android": { "$value": { "value": 48, "unit": "px" } },
    "button-height": { "$value": { "value": 56, "unit": "px" } },
    "input-height": { "$value": { "value": 52, "unit": "px" } },
    "avatar": { "$value": { "value": 44, "unit": "px" } },
    "icon": { "$value": { "value": 24, "unit": "px" } },
    "tab-bar-height": { "$value": { "value": 64, "unit": "px" } },
    "border": { "$value": { "value": 1, "unit": "px" } },
    "focus-ring": { "$value": { "value": 3, "unit": "px" } },
    "progress-height": { "$value": { "value": 8, "unit": "px" } },
    "content-max-width": { "$value": { "value": 640, "unit": "px" }, "$description": "Web single-column max width" }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 320, "unit": "ms" } }
  }
}
